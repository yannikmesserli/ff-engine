{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/*.json"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "useLiteralKeys": "off" },
      "suspicious": { "noArrayIndexKey": "off", "noAssignInExpressions": "off", "useIterableCallbackReturn": "off" },
      "a11y": { "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off", "useButtonType": "off" }
    }
  },
  "overrides": [{ "includes": ["**/*.tsx"], "linter": { "domains": { "react": "recommended" } } }]
}
